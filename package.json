{
  "name": "imageiq-resizer",
  "productName": "ImageIQ Resizer",
  "version": "0.2.0",
  "description": "Local media-downscaling engine + CLI for STOCK IMAGEIQ (lowres proxy trees for metadata processing)",
  "private": true,
  "main": "./out/main/index.js",
  "bin": {
    "iq-shrink": "dist/src/cli.js"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build:app": "electron-vite build",
    "start": "electron-vite preview",
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "clean": "rm -rf dist out",
    "package:mac": "electron-vite build && electron-builder --mac dmg",
    "package:win": "electron-vite build && electron-builder --win nsis --x64"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.4",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "author": "STOCK IMAGEIQ <info@stockimageiq.com>"
}
