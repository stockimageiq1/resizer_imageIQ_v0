# Apple notarisation — template. Copy to .env.signing (never committed, see
# .gitignore), fill in, then load it into the shell before a signed build:
#   set -a; source .env.signing; set +a
# The certificate itself (Developer ID Application) is not named here:
# electron-builder finds it in the login keychain. If the keychain has more
# than one, set CSC_NAME to the one to use (its SHA-1 hash or its name without
# the "Developer ID Application: " prefix) in the shell, not in this file.
APPLE_API_KEY=/Users/<ime>/.private_keys/AuthKey_XXXXXXXXXX.p8
APPLE_API_KEY_ID=
APPLE_API_ISSUER=
APPLE_TEAM_ID=
